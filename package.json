{
  "name": "dsh-forge",
  "version": "0.1.0",
  "description": "DeepSeek Harness tools for self-hosted Gitea and Forgejo instances.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "biome check .",
    "format": "biome format --write .",
    "prepare": "node ./node_modules/typescript/bin/tsc -p tsconfig.json",
    "test": "node ./node_modules/vitest/vitest.mjs run",
    "test:coverage": "node ./node_modules/vitest/vitest.mjs run --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "forgejo",
    "gitea",
    "git",
    "agent"
  ],
  "author": "Max Hsu",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maxmilian/dsh-forge.git"
  },
  "bugs": {
    "url": "https://github.com/maxmilian/dsh-forge/issues"
  },
  "homepage": "https://github.com/maxmilian/dsh-forge#readme",
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.4",
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6",
    "@types/node": "^24.3.0",
    "@vitest/coverage-v8": "^4.1.8",
    "typescript": "^6.0.2",
    "vitest": "^4.1.8"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "packageManager": "bun@1.3.5"
}
